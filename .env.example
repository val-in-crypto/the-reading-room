# Keep all keys server-side. Never prefix these with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Choose 3–4 voice IDs available to your account (GET /v1/voices).
ELEVENLABS_VOICE_IDS=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: shared access code to protect the paid speech endpoint on a public prototype.
PROTOTYPE_ACCESS_CODE=
